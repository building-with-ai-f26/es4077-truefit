  "narrative": {
    "northStar": "The Exhibit",
    "overview": "Every result TrueFit gives is laid out like an exhibit in a consulting deck, the format Stern MBAs read every day. The exhibit's action title states the answer in one sentence. Each row underneath gives one requirement or bullet, a status mark with a word, and the proof: the quoted line, highlighted, with where it came from. Trust comes from the proof being visible, not from emphasis.\n\nThe app (`app/static/`) is an Operate surface. A deck-navy top bar holds the wordmark and the three steps as tabs. Below it, each step is a band: a 440px white input panel on the left, and that step's exhibit on a cool grey ground on the right. On narrow screens each band stacks, with the exhibit under its inputs.\n\nThe Product Page (`docs/index.html`) is a Read surface in the same system: the navy top bar (wordmark, section links, course line), the pitch as a 36px action title over a 2px navy rule on a Ground band, then one reading column (980px, prose at 70ch) with 36px section titles, 16px subsection titles over a 2px navy rule, hairline tables with caps headers, and the unit economics as a ledger of labelled rows rather than cards.",
    "keyCharacteristics": [
      "An action title per exhibit",
      "A status mark and a word on every row",
      "Highlighted proof",
      "Hairlines, 4px corners, no shadows",
      "Three type sizes"
    ],
    "rules": [
      {
        "name": "The Highlighter Rule",
        "body": "Yellow means proof: quoted posting text, plus the current tab and selection.",
        "section": "colors"
      },
      {
        "name": "The One Teal Rule",
        "body": "Each step has exactly one teal button.",
        "section": "colors"
      },
      {
        "name": "The Quote Rule",
        "body": "Italic means verbatim.",
        "section": "typography"
      },
      {
        "name": "The Three Sizes Rule",
        "body": "New text uses 36, 16, or 13px.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do open every exhibit with a one-sentence action title.",
      "Do pair every status color with its glyph and word.",
      "Do show the highlighted proof next to every claim.",
      "Do show only what the app actually checks."
    ],
    "donts": [
      "Don't add shadows, gradients, or corners beyond 4px.",
      "Don't use yellow for anything but proof, the current tab, and selection.",
      "Don't use status colors as decoration.",
      "Don't invent source details such as posting line numbers."
    ]
  }
